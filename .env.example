# Application
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-here

# Streamlit
STREAMLIT_PORT=8501
MAX_UPLOAD_SIZE_MB=10

# Terraform
TERRAFORM_WORKING_DIR=./infra
TERRAFORM_STATE_BACKEND=local
# TERRAFORM_STATE_BUCKET=your-terraform-state-bucket
# TERRAFORM_LOCK_TABLE=terraform-locks

# AWS
AWS_REGION=us-east-1
# AWS_PROFILE=default

# Security
ENABLE_AUTH=false
ALLOWED_FILE_TYPES=json,yaml,yml

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
