# Application
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-here

# Streamlit
STREAMLIT_PORT=8501
MAX_UPLOAD_SIZE_MB=10

# Terraform
TERRAFORM_WORKING_DIR=./infra
TERRAFORM_STATE_BACKEND=local
# TERRAFORM_STATE_BUCKET=your-terraform-state-bucket
# TERRAFORM_LOCK_TABLE=terraform-locks

# AWS
AWS_REGION=us-east-1
# AWS_PROFILE=default

# Security
ENABLE_AUTH=true
ALLOWED_FILE_TYPES=json,yaml,yml

# Authentication Provider (auth0 or cognito)
AUTH_PROVIDER=auth0

# Auth0 Configuration (if using Auth0)
AUTH0_DOMAIN=your-domain.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_AUDIENCE=https://your-domain.auth0.com/api/v2/
AUTH0_REDIRECT_URI=http://localhost:8501/callback

# AWS Cognito Configuration (if using Cognito)
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=your-client-id
COGNITO_CLIENT_SECRET=your-client-secret
COGNITO_REGION=us-east-1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
