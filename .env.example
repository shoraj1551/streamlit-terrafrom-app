# Application
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-here

# Streamlit
STREAMLIT_PORT=8501
MAX_UPLOAD_SIZE_MB=10

# Terraform
TERRAFORM_WORKING_DIR=./infra
TERRAFORM_STATE_BACKEND=local
# TERRAFORM_STATE_BUCKET=your-terraform-state-bucket
# TERRAFORM_LOCK_TABLE=terraform-locks

# AWS
AWS_REGION=us-east-1
# AWS_PROFILE=default

# Security
ENABLE_AUTH=true
ALLOWED_FILE_TYPES=json,yaml,yml

# Authentication Provider (REQUIRED)
# Use Auth0 for enterprise-grade authentication
AUTH_PROVIDER=auth0

# Auth0 Configuration (REQUIRED - Get from Auth0 Dashboard)
# 1. Create an Auth0 account at https://auth0.com
# 2. Create a new Application (Regular Web Application)
# 3. Copy the values below from your Auth0 Application settings
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-client-id-from-auth0
AUTH0_CLIENT_SECRET=your-client-secret-from-auth0
AUTH0_AUDIENCE=https://your-tenant.us.auth0.com/api/v2/
AUTH0_REDIRECT_URI=http://localhost:8501

# DEPRECATED: AWS Cognito (not currently implemented)
# COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
# COGNITO_CLIENT_ID=your-client-id
# COGNITO_CLIENT_SECRET=your-client-secret
# COGNITO_REGION=us-east-1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Encryption (REQUIRED for production)
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_MASTER_KEY=your-32-byte-base64-encoded-key-here

# Database (PostgreSQL for production, SQLite for development)
# PostgreSQL format: postgresql://user:password@host:port/database
# DATABASE_URL=postgresql://terraform_user:terraform_dev_password@localhost:5432/terraform_app
# SQLite fallback (not recommended for production):
# DATABASE_URL=sqlite:///./data/deployments.db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=terraform_redis_password

# Session Management
SESSION_TTL=3600  # 1 hour in seconds
REFRESH_TOKEN_TTL=2592000  # 30 days in seconds

# Celery (Background Jobs)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
